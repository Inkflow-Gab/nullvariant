<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#080D14"
                android:endColor="#05070B"
                android:startColor="#0F1E30"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape>
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:centerColor="#111FD1FF"
                android:endColor="#001FD1FF"
                android:gradientRadius="320dp"
                android:startColor="#331FD1FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
